# MyHub v2 — Environment variables template
# Copy to .env.local and fill in real values.

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Postgres connection string (Settings → Database → Connection string).
# Use Direct (port 5432) for migrations, Transaction Pooler (6543) for runtime.
# URL-encode special characters in password: ! → %21, @ → %40, etc.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Single-user whitelist for Google OAuth gate
ALLOWED_EMAIL=your-email@gmail.com

# Anthropic — 6명 에이전트 전부 Anthropic 사용 (Sonnet 2 + Haiku 4).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx

# Google OAuth (캘린더 연동용)
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxx

# OAuth refresh token 암호화 키. 32바이트 이상 권장.
# 생성: openssl rand -base64 48
# 키가 바뀌면 기존 oauth_tokens 행은 복호화 불가 — 재로그인 필요.
OAUTH_TOKEN_KEY=replace-with-openssl-rand-base64-48

# Vercel Cron 인증. 매일 8시 데일리 + 5분 캘린더 동기화 호출에 사용.
# 생성: openssl rand -base64 32
# Vercel 배포 시 Project Settings → Environment Variables에도 동일하게 등록.
CRON_SECRET=replace-with-openssl-rand-base64-32

# ─────────────────────────────────────────────────────────────
# Telegram bot — 알림 push 채널 (옵션, 미설정 시 인앱만)
# 봇 만들기: BotFather (@BotFather) 에서 /newbot → 토큰 발급
# Chat ID 확인: 봇과 1:1 대화 시작 → https://api.telegram.org/bot<token>/getUpdates
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# Sentry (옵션). 설정 시 서버 에러가 Sentry로 전송. 미설정 시 console.error만.
# SENTRY_DSN=https://...
# ─────────────────────────────────────────────────────────────

# MyHub — Environment variables template
# Copy to .env.local and fill in real values.

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Postgres connection string (Settings → Database → Connection string).
# Use Direct (port 5432) for migrations, Transaction Pooler (6543) for runtime.
# URL-encode special characters in password: ! → %21, @ → %40, etc.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Single-user whitelist for Google OAuth gate
ALLOWED_EMAIL=your-email@gmail.com

# Phase 1+ (added later)
# ANTHROPIC_API_KEY=sk-ant-xxx
# GITHUB_PAT=ghp_xxx
# GITHUB_WEBHOOK_SECRET=random-string-for-hmac
# GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxx

# Phase 2B — OAuth refresh token 암호화 키.
# 32바이트 이상 권장. 생성: `openssl rand -base64 48`
# 키가 바뀌면 기존 oauth_tokens 행은 복호화 불가 — 재로그인 필요.
OAUTH_TOKEN_KEY=replace-with-openssl-rand-base64-48

# Phase 3 — OpenAI 임베딩 (text-embedding-3-small + dimensions=1024)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxx

# 옵시디언 vault 절대 경로 (재귀적으로 .md 스캔). 로컬 경로라 .env.local 전용.
# 예: /Users/me/Library/CloudStorage/GoogleDrive-x/내 드라이브/옵시디언/wiki
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Phase 7 — Vercel Cron 인증.
# Vercel은 cron 호출 시 `Authorization: Bearer ${CRON_SECRET}` 헤더를 보낸다.
# 생성: openssl rand -base64 32
# Vercel 배포 시 Project Settings → Environment Variables에도 같은 값 등록.
CRON_SECRET=replace-with-openssl-rand-base64-32

# GitHub 동기화 대상 조직 (cron/hourly 사용)
GITHUB_ORG=FlowTo-ai

# Phase 7 — Sentry (선택). 설정하면 서버 에러가 Sentry로 전송됨.
# DSN 미설정 시 console.error만.
# SENTRY_DSN=https://...

# Phase 7 — Skills 자동 스캔 경로 오버라이드 (기본 ~/.claude/skills)
# CLAUDE_SKILLS_PATH=/path/to/skills

# Phase 8 — Google Gemini (8명 agent inference. 혜원·민지는 여전히 Anthropic).
# 발급: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza-xxx

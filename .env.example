# MyHub — Environment variables template
# Copy to .env.local and fill in real values.

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Postgres connection string (Settings → Database → Connection string).
# Use Direct (port 5432) for migrations, Transaction Pooler (6543) for runtime.
# URL-encode special characters in password: ! → %21, @ → %40, etc.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Single-user whitelist for Google OAuth gate
ALLOWED_EMAIL=your-email@gmail.com

# Phase 1+ (added later)
# ANTHROPIC_API_KEY=sk-ant-xxx
# GITHUB_PAT=ghp_xxx
# GITHUB_WEBHOOK_SECRET=random-string-for-hmac
# GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxx
